<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WarungSkuy"
        tools:targetApi="31">

        <!-- Splash Activity sebagai Launcher -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.WarungSkuy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Choice Activity -->
        <activity
            android:name=".activities.AuthChoiceActivity"
            android:exported="false" />

        <!-- Login Activity -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- Profile Activity -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false" />

        <!-- Register Activity -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- Home Activity -->
        <activity
            android:name=".activities.HomeActivity"
            android:exported="false" />

        <!-- Products Activity -->
        <activity
            android:name=".activities.ProductsActivity"
            android:exported="false" />

        <!-- Cart Activity -->
        <activity
            android:name=".activities.CartActivity"
            android:exported="false" />

        <!-- Address Activity -->
        <activity
            android:name=".activities.AddressActivity"
            android:exported="false" />

        <!-- Confirmation Activity -->
        <activity
            android:name=".activities.ConfirmationActivity"
            android:exported="false" />

        <!-- History Activity -->
        <activity
            android:name=".activities.HistoryActivity"
            android:exported="false" />

        <!-- Detail History Activity -->
        <activity
            android:name=".activities.DetailHistoryActivity"
            android:exported="false" />

    </application>

</manifest>